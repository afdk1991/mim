# Mim 云端后端配置（CloudBase 腾讯云 · PostgreSQL 模式）
# 复制本文件为 .env（本地开发），CI 已在 .github/workflows/ci-cd.yml 中直接注入
# 缺失 env id 或 accessKey → 应用自动回退「本地演示模式」（localStorage）
#
# 取值位置：CloudBase 控制台 → 环境 → API 密钥 → Publishable Key
#   VITE_CLOUDBASE_ENV_ID      = 环境 ID（形如 cs-1-xxxxxxxx）
#   VITE_CLOUDBASE_ACCESS_KEY  = Publishable Key（公开凭据，安全由 RLS 保障）
#   VITE_CLOUDBASE_REGION      = 环境地域，默认 ap-shanghai

VITE_CLOUDBASE_ENV_ID=cs-1-d5g815slocb5a611a
VITE_CLOUDBASE_REGION=ap-shanghai
VITE_CLOUDBASE_ACCESS_KEY=YOUR-PUBLISHABLE-KEY
