# ============================================================
# Mim 第三方 SDK / API 密钥占位模板
# 用法：复制为 .env（本地开发）或写入 CI Secret / 云 KMS（生产）
# 规则：本文件只允许出现空值与说明，禁止填写真实密钥后提交
# 清单来源：docs/wiki/09-third-party-sdk-inventory.md
# ============================================================

# ---------- 账号与身份 ----------
# ---- 第三方登录通用配置 ----
# 后端对外基址（拼默认回调地址用；反代已透传 X-Forwarded-* 时可留空，按请求推导）
# 生产示例：https://api.laal.top:8443（443 归同机 MixmAPP；切换后须同步更新各第三方平台后台登记的 redirect_uri）
MIM_OAUTH_CALLBACK_BASE=
# 前端站点基址（第三方回调完成后 302 回 SPA 用；与后端同源部署时留空即可）
# 子路径部署示例：https://afdk1991.github.io/mim
MIM_WEB_BASE_URL=
# 每个提供方都可单独覆盖回调地址：MIM_AUTH_<ID>_REDIRECT_URI，<ID> 取 GITHUB / GITEE / GITLAB /
# GOOGLE / APPLE / MICROSOFT / WECHAT / QQ / DOUYIN / WEIBO / BAIDU / ALIPAY / FACEBOOK / TWITTER。默认值为
# ${MIM_OAUTH_CALLBACK_BASE}/api/v1/auth/oauth/<id>/callback，必须与提供方后台登记逐字一致。
# 同理可覆盖端点：MIM_AUTH_<ID>_AUTHORIZE_URL / _TOKEN_URL / _PROFILE_URL / _JWKS_URL
# （私有化部署 GitHub Enterprise、自建 GitLab 与自动化测试用；生产默认走官方域名）

# ---- GitHub OAuth App ----
MIM_AUTH_GITHUB_CLIENT_ID=
MIM_AUTH_GITHUB_CLIENT_SECRET=
# ---- Gitee 第三方应用 ----
MIM_AUTH_GITEE_CLIENT_ID=
MIM_AUTH_GITEE_CLIENT_SECRET=
# ---- GitLab 应用（gitlab.com 或私有实例） ----
MIM_AUTH_GITLAB_CLIENT_ID=
MIM_AUTH_GITLAB_CLIENT_SECRET=
# ---- Google OAuth 2.0 客户端 ----
MIM_AUTH_GOOGLE_CLIENT_ID=
MIM_AUTH_GOOGLE_CLIENT_SECRET=
# ---- Apple Sign in with Apple（Service ID + p8 私钥 + Team/Key ID） ----
MIM_AUTH_APPLE_SERVICE_ID=
MIM_AUTH_APPLE_TEAM_ID=
MIM_AUTH_APPLE_KEY_ID=
# p8 私钥全文；换行用 \n 转义，服务端会还原为 PEM
MIM_AUTH_APPLE_PRIVATE_KEY=
# 可选：Apple 的回调地址单独登记时使用（默认与其它 provider 同规则）
MIM_AUTH_APPLE_REDIRECT_URI=
# ---- Microsoft Entra ID（多租户 / 个人账号） ----
MIM_AUTH_MICROSOFT_CLIENT_ID=
MIM_AUTH_MICROSOFT_CLIENT_SECRET=
# ---- 微信开放平台 网站应用扫码登录 ----
MIM_AUTH_WECHAT_APP_ID=
MIM_AUTH_WECHAT_APP_SECRET=
# ---- QQ 互联 ----
MIM_AUTH_QQ_APP_ID=
MIM_AUTH_QQ_APP_KEY=
# ---- 抖音开放平台（网站应用） ----
MIM_AUTH_DOUYIN_CLIENT_KEY=
MIM_AUTH_DOUYIN_CLIENT_SECRET=
# ---- 微博开放平台（2026-11-14 注册表第 10 家登录） ----
MIM_AUTH_WEIBO_CLIENT_ID=
MIM_AUTH_WEIBO_CLIENT_SECRET=
# ---- 百度开放平台（standard 通用客户端） ----
MIM_AUTH_BAIDU_CLIENT_ID=
MIM_AUTH_BAIDU_CLIENT_SECRET=
# ---- Facebook（Graph API v19.0，海外区） ----
MIM_AUTH_FACEBOOK_CLIENT_ID=
MIM_AUTH_FACEBOOK_CLIENT_SECRET=
# ---- Twitter / X（OAuth2 PKCE + Basic，海外区） ----
MIM_AUTH_TWITTER_CLIENT_ID=
MIM_AUTH_TWITTER_CLIENT_SECRET=
# ---- 支付宝（支付场景，非登录） ----
MIM_AUTH_ALIPAY_APP_ID=
MIM_AUTH_ALIPAY_PRIVATE_KEY=
MIM_AUTH_ALIPAY_PUBLIC_KEY=
MIM_SMS_ALIYUN_ACCESS_KEY_ID=
MIM_SMS_ALIYUN_ACCESS_KEY_SECRET=
MIM_SMS_ALIYUN_SIGN_NAME=
# 阿里云短信模板 CODE（模板须含变量 ${code}，如 SMS_123456789）
MIM_SMS_ALIYUN_TEMPLATE_CODE=
MIM_SMS_TENCENT_SECRET_ID=
MIM_SMS_TENCENT_SECRET_KEY=
MIM_SMS_TENCENT_SDK_APP_ID=
MIM_EMAIL_ALIYUN_ACCESS_KEY=
MIM_EMAIL_SES_ACCESS_KEY_ID=
MIM_EMAIL_SES_SECRET_ACCESS_KEY=
# SES 区域（缺省回退 us-east-1）与发件人地址（须在 SES 完成验证）
MIM_EMAIL_SES_REGION=
MIM_EMAIL_SES_FROM_ADDRESS=
# 管理员口令（POST /api/v1/auth/password）已收敛到账号自身：只校验 credentials.kind=password 的 bcrypt 哈希。
# 2026-11-15 起不再读取 MIM_AUTH_ADMIN_PASSWORD / MIM_AUTH_ADMIN_IDENTIFIERS，请通过后台「用户 → 重置口令」维护。

# ---------- 邮件 ----------
# 站点选项「邮件」分组只保存 SMTP 连接参数；口令只在此环境变量，不入库、不下发前端
MIM_SMTP_PASSWORD=

# ---------- 推送 ----------
MIM_PUSH_APNS_KEY_ID=
MIM_PUSH_APNS_TEAM_ID=
MIM_PUSH_APNS_PRIVATE_KEY=
MIM_PUSH_APNS_TOPIC=
MIM_PUSH_FCM_PROJECT_ID=
MIM_PUSH_FCM_SERVICE_ACCOUNT_JSON=
MIM_PUSH_HUAWEI_APP_ID=
MIM_PUSH_HUAWEI_APP_SECRET=
MIM_PUSH_XIAOMI_APP_ID=
MIM_PUSH_XIAOMI_APP_KEY=
MIM_PUSH_OPPO_APP_KEY=
MIM_PUSH_OPPO_MASTER_SECRET=
MIM_PUSH_VIVO_APP_ID=
MIM_PUSH_VIVO_APP_KEY=
MIM_PUSH_JPUSH_APP_KEY=
MIM_PUSH_JPUSH_MASTER_SECRET=
MIM_PUSH_GETUI_APP_ID=

# ---------- IM / 消息 ----------
MIM_IM_TENCENT_SDK_APP_ID=
MIM_IM_TENCENT_SECRET_KEY=
MIM_IM_HUANXIN_APP_KEY=
MIM_IM_RONGCLOUD_APP_KEY=
MIM_IM_RONGCLOUD_APP_SECRET=
MIM_IM_SENDBIRD_APP_ID=
MIM_IM_STREAM_API_KEY=
MIM_MSG_TWILIO_ACCOUNT_SID=
MIM_MSG_TWILIO_AUTH_TOKEN=

# ---------- 音视频 ----------
MIM_RTC_AGORA_APP_ID=
MIM_RTC_AGORA_APP_CERTIFICATE=
MIM_RTC_TENCENT_SDK_APP_ID=
MIM_RTC_TENCENT_SECRET_KEY=
MIM_RTC_ZEGO_APP_ID=
MIM_RTC_ZEGO_APP_SIGN=
MIM_RTC_LIVEKIT_API_KEY=
MIM_RTC_LIVEKIT_API_SECRET=
MIM_RTC_LIVEKIT_URL=

# ---------- 内容审核 / 验证码 ----------
MIM_MODERATION_SHUME_ACCESS_KEY=
MIM_MODERATION_SHUME_APP_ID=
MIM_MODERATION_YIDUN_SECRET_ID=
MIM_MODERATION_YIDUN_SECRET_KEY=
MIM_MODERATION_ALIYUN_ACCESS_KEY=
MIM_MODERATION_TENCENT_SECRET_ID=
MIM_CAPTCHA_TENCENT_APP_ID=
MIM_CAPTCHA_GEETEST_ID=
MIM_CAPTCHA_GEETEST_KEY=
# 验证码模式：off | image | slider | tencent | geetest4。
# 生产环境未配置时默认 image 并强制 register/login（自托管图形验证码，无需第三方凭证）；
# 非生产环境未配置时默认 off。显式配置 off 视为运维有意关闭。
MIM_CAPTCHA_MODE=
# 场景级强制开关（1 强制 / 0 显式关闭 / 留空按环境默认）：MIM_CAPTCHA_REGISTER / MIM_CAPTCHA_LOGIN /
# MIM_CAPTCHA_REPORT / MIM_CAPTCHA_POST。生产默认强制前两者（注册与登录，含 /auth/password）。
MIM_CAPTCHA_REGISTER=
MIM_CAPTCHA_LOGIN=
# 旧的全场景强制开关（1 = 所有场景强制），保留兼容；新部署建议用上面的场景级开关
MIM_CAPTCHA_REQUIRED=

# ---------- 存储 / CDN ----------
MIM_STORAGE_S3_ACCESS_KEY_ID=
MIM_STORAGE_S3_SECRET_ACCESS_KEY=
# 运行期存储驱动（local | s3；留空默认 local，本地磁盘无需云凭证即可真实落盘）
# 私有桶基线：聊天与社区附件等所有对象一律由服务端签发短时 URL（local 走 HMAC、s3 走 SigV4），
# 代码里没有「公有读」降级分支。
# 严格校验：MIM_STORAGE_DRIVER=s3 时，下方 BUCKET / REGION / ACCESS_KEY_ID / SECRET_ACCESS_KEY
# 四项缺任意一项，进程启动即抛 STORAGE_CONFIG_INVALID 并列出缺失变量名，不会静默回落本地磁盘。
# 同理，驱动留空但已填了任意一项 S3 变量（说明在配桶却没配完）也会启动失败。
MIM_STORAGE_DRIVER=
# 本地驱动落盘根目录（留空默认 <服务目录>/data/media）
MIM_STORAGE_LOCAL_DIR=
# S3 兼容端点（OSS / COS / R2 / MinIO 等；AWS S3 可留空）
MIM_STORAGE_S3_ENDPOINT=
# S3 区域（s3 模式下必填；R2 填 auto，AWS 填如 us-east-1，腾讯 COS 填如 ap-beijing）
MIM_STORAGE_S3_REGION=
# S3 存储桶名（s3 模式下必填；桶须设为私有，公共读会绕过本服务的签名与归属校验）
MIM_STORAGE_S3_BUCKET=
# S3 路径风格（MinIO 填 1，AWS 兼容虚拟主机方式填 0）
MIM_STORAGE_S3_FORCE_PATH_STYLE=
# 对外公开基址（本地驱动预签名 URL 拼接用，如 https://zy.laal.top）
MIM_PUBLIC_BASE_URL=
# CDN 主动刷新（可选；本部署 nginx 直出 + hash 文件名长缓存 + HTML no-cache，默认不需要 purge）。
# 仅 cloudflare / edgeone 两条 REST 链路实现；CloudFront 显式不支持（CDN_PROVIDER_UNSUPPORTED），无需配置其凭证。
MIM_CDN_CLOUDFLARE_API_TOKEN=
MIM_CDN_ALIYUN_ACCESS_KEY=

# ---------- 可观测性 / 分析 ----------
MIM_OBS_SENTRY_DSN=
MIM_OBS_SENTRY_AUTH_TOKEN=
MIM_OBS_DATADOG_API_KEY=
MIM_OBS_GRAFANA_TOKEN=
MIM_OBS_LANGFUSE_PUBLIC_KEY=
MIM_OBS_LANGFUSE_SECRET_KEY=
MIM_ANALYTICS_UMAMI_WEBSITE_ID=
MIM_ANALYTICS_GA4_MEASUREMENT_ID=
MIM_ANALYTICS_MIXPANEL_TOKEN=

# ---------- 地图与位置 ----------
MIM_MAP_AMAP_KEY=
MIM_MAP_AMAP_SECURITY_CODE=
MIM_MAP_BAIDU_AK=
MIM_MAP_TENCENT_KEY=
MIM_MAP_GOOGLE_API_KEY=
MIM_MAP_MAPBOX_TOKEN=

# ---------- 北斗卫星导航 ----------
# L2 高精度定位（纯软件，按需开通）
MIM_BDS_QIANXUN_APP_KEY=
MIM_BDS_QIANXUN_APP_SECRET=
MIM_BDS_QIANXUN_SERVICE_ID=
MIM_BDS_LIUFEN_APP_ID=
MIM_BDS_LIUFEN_APP_KEY=
MIM_BDS_CMCC_APP_ID=
MIM_BDS_CMCC_APP_SECRET=
# L3 短报文（依赖硬件终端，P0 排除项，默认不启用）
MIM_BDS_RDSS_TERMINAL_ID=
MIM_BDS_RDSS_APP_KEY=
MIM_BDS_RDSS_APP_SECRET=

# ---------- 应用自有配置 ----------
# JWT HS256 签名密钥（>=32 字符随机串，生产必配；本地开发留空则自动生成 .mim-dev-secret/jwt.key）
MIM_JWT_SECRET=
# 跨域来源白名单（逗号分隔；本模板仅留空，真实值由 CI Secret / 服务器 .env 注入）
# 仅「前端跨域直连本 API」的镜像站需要：GitHub Pages（VITE_API_ORIGIN=api.laal.top）必配；
# Cloudflare Pages / Vercel 走同源 /api 反代（functions/rewrites），无需此项；留空则不启用 CORS 中间件。
# 若漏配，对应镜像站浏览器会拦截 /api/v1/shop/products，导致「社区商城看不到」。
# 参考白名单：https://afdk1991.github.io,https://zy.laal.top,https://api.laal.top,https://data.mixm.top（deploy/deploy.sh 已幂等补齐）
MIM_CORS_ORIGINS=
# 可信反向代理（Express trust proxy）：决定 req.ip 是否采信 X-Forwarded-For。
# 取值：loopback（默认，只信任同机 nginx）/ 整数跳数 / 逗号分隔 CIDR / false（完全关闭）/ true（信任全部，慎用）。
# 绝不要无条件信任 X-Forwarded-For，否则攻击者可伪造来源 IP 绕过登录失败锁定。
MIM_TRUST_PROXY=
# 超管引导令牌（RBAC bootstrap）：缺失时 /api/v1/admin/* 等管理写路由返回 403；仅由 CI Secret 下发，禁止落盘
MIM_ADMIN_TOKEN=
# 自研算法参数覆盖（JSON，局部字段即可）：bm25{k1,b,title,summary,body} / rank{halfLifeDays,engagementWeight}
# / heat{likes,replies,views,favorites,gravity} / window{search,trending}。
# 优先级：本变量 > site_settings（后台 PUT /api/v1/community/algorithm-weights）> 内置默认值；越界值会被夹取。
MIM_ALGORITHM_WEIGHTS=
# 支付渠道回调签名密钥（POST /api/v1/orders/:id/payment-notify 的 HMAC-SHA256 密钥）；
# 留空则该回调返回 503 PAYMENT_NOTIFY_NOT_CONFIGURED，人工结算（POST /orders/:id/settle）不受影响
MIM_PAYMENT_NOTIFY_SECRET=
# ---------- 商业化二期：支付 / 归属地 ----------
# 支付宝当面付：应用 ID、应用私钥（RSA2）、异步通知地址；前两项缺一即 PROVIDER_NOT_CONFIGURED
MIM_ALIPAY_APP_ID=
MIM_ALIPAY_PRIVATE_KEY=
MIM_ALIPAY_NOTIFY_URL=
# 支付宝开放平台公钥：POST /api/v1/payments/alipay/notify 用它做 RSA2 验签；留空则该回调一律回 failure
MIM_ALIPAY_PUBLIC_KEY=
# 微信企业支付 Native：商户号、APIv3 密钥、证书序列号、商户私钥；四项缺一即 PROVIDER_NOT_CONFIGURED
MIM_WECHAT_MCH_ID=
MIM_WECHAT_API_V3_KEY=
MIM_WECHAT_SERIAL_NO=
MIM_WECHAT_PRIVATE_KEY=
# 人工转账 / 线下收款展示说明（不含密钥）
MIM_MANUAL_PAY_ACCOUNT=
# 沙箱支付开关（仅测试 / 预发设为 1）与回调 HMAC 密钥
MIM_PAYMENT_SANDBOX=
MIM_PAYMENT_SANDBOX_SECRET=
# IP 归属地哈希盐；留空回落 MIM_JWT_SECRET
MIM_IP_HASH_SALT=
# 后台定时任务总开关（留空默认 1 启用；显式 0 关闭，用于多副本部署只让一个实例消费）
MIM_JOBS=
# 注册总开关（2026-11-15 起默认关闭；仅显式 1 才允许自助注册 / 验证码首登 / OAuth 首登 / 免登录访客建号）
MIM_REGISTRATION_ENABLED=
# 全站门禁总开关（2026-11-15 起默认开启：匿名可读、登录才能互动；仅显式 0/false/off 关闭，供排障与测试使用）
MIM_FORCE_LOGIN=
MIM_REGISTER_INVITE_REQUIRED=
MIM_AUDIT_FALLBACK=
MIM_REDIS_URL=
MIM_REPORT_LIMIT=
MIM_REPORT_WINDOW_MINUTES=
# 圈子创建门槛：最小用户等级与每用户可创建数量（留空默认 0 / 1）
MIM_CIRCLE_CREATE_MIN_LEVEL=
MIM_CIRCLE_CREATE_MAX_PER_USER=
# OIDC 联邦身份（标准授权码模式，services/mim-api/src/federation.ts）：
# 四项缺一即 configured=false，登录端点诚实返回 503；ID Token 签名验签待补（见文件头能力边界）
MIM_OIDC_ISSUER=
MIM_OIDC_CLIENT_ID=
MIM_OIDC_CLIENT_SECRET=
MIM_OIDC_REDIRECT_URI=
# 推广返佣结算（services/mim-api/src/commerce/referral-settlement.ts）：
# 一级佣金比例 / 二级佣金比例 / 归因保护期天数；留空默认 0.05 / 0 / 7
MIM_REFERRAL_RATE=
MIM_REFERRAL_L2_RATE=
MIM_REFERRAL_PROTECT_DAYS=
# 推广点击 / 转化频控（services/mim-api/src/content/promotions.ts）：
# 滑动窗口秒数（点击与转化共用，缺省 600）；窗口内点击上限 / 转化上限（缺省各 10，显式 0 关闭频控，不建议生产关闭）
MIM_CONTENT_CLICK_WINDOW_SECONDS=
MIM_CONTENT_CLICK_MAX=
MIM_CONTENT_CONVERSION_MAX=

# ============================================================
# 部署端口（同机共存，deploy/nginx-mim.conf + deploy.sh + bootstrap.sh 共用口径）
# ============================================================
# 背景：Mim 与 MixmAPP 共用 115.159.159.11，80/443 归 MixmAPP，Mim 用独立端口。
# 全部可配；nginx 模板以 __MIM_WEB_HTTP_PORT__ / __MIM_WEB_HTTPS_PORT__ / __MIM_API_PORT__
# 占位，由部署脚本渲染，禁止在配置里再硬编码 80/443/8787。
# 前端 HTTP（nginx，主站 + www + api + 功能子域共用）；留空默认 8080
MIM_WEB_HTTP_PORT=
# 前端 HTTPS（nginx，证书就绪时由部署脚本注入 8443 ssl；未就绪时保持注释，不影响 nginx -t）；留空默认 8443
MIM_WEB_HTTPS_PORT=
# 后端回环端口（API 与 WebSocket 共用同一监听，无独立 WS 端口；nginx 反代与 systemd PORT 同源）；留空默认 8787
MIM_API_PORT=
# 证书策略：0=同机共存（默认，不跑 certbot、不碰 80/443，证书用 DNS-01 另签）；1=独占 80/443 老路径；留空默认 0
MIM_TLS_CERTBOT=
# default_server 归属：0=保留同机既有 default 站点（80/443 归 MixmAPP）；1=删除并独占机器；留空默认 0
MIM_NGINX_TAKE_DEFAULT=

# ============================================================
# 仅内部测试 / 部署编排 / 离线遗留变量（不进入生产必填模板）
# ------------------------------------------------------------
# 下列变量只被自检取证脚本、deploy 编排脚本或已下线模块引用，按家族在
# docs/wiki/09-third-party-sdk-inventory.md §18 通配登记；本地跑脚本时按需在命令行注入，
# 不在此留赋值行（避免测试变量占用生产模板位）。
#   取证脚本：MIM_EVIDENCE_ADMIN_TOKEN / MIM_EVIDENCE_API_BASE / MIM_EVIDENCE_AUTH_TOKEN /
#             MIM_EVIDENCE_BROWSER / MIM_EVIDENCE_CDP / MIM_EVIDENCE_DB_PATH /
#             MIM_EVIDENCE_KEEP_BROWSER / MIM_EVIDENCE_TIMEOUT_MS / MIM_EVIDENCE_WEB_BASE
#   门禁 E2E：MIM_GATE_API / MIM_GATE_CDP / MIM_GATE_PAGE
#   性能基准 / 截图：MIM_API_BASE / MIM_PERF_TARGET_MS / MIM_E2E_PNG
#   部署编排：MIM_ENV_FILE / MIM_DEPLOY_STOP_AFTER（演练早退，生产勿设）
#   离线遗留：MIM_AI_WORKER / MIM_AI_HOURLY_COST_LIMIT_MINOR / MIM_AI_ALLOW_INSECURE_BASE /
#             MIM_FILM_REVIEW_SLA_HOURS / MIM_PUBLIC_ORIGIN / MIM_ENABLE_BACKUP_TIMER /
#             MIM_SERVICE_VERSION / MIM_DB_PATH
# ============================================================
