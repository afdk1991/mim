# ============================================================
# Mim 第三方 SDK / API 密钥占位模板
# 用法：复制为 .env（本地开发）或写入 CI Secret / 云 KMS（生产）
# 规则：本文件只允许出现空值与说明，禁止填写真实密钥后提交
# 清单来源：docs/wiki/09-third-party-sdk-inventory.md
# ============================================================

# ---------- 账号与身份 ----------
MIM_AUTH_WECHAT_APP_ID=
MIM_AUTH_WECHAT_APP_SECRET=
MIM_AUTH_ALIPAY_APP_ID=
MIM_AUTH_ALIPAY_PRIVATE_KEY=
MIM_AUTH_ALIPAY_PUBLIC_KEY=
MIM_AUTH_GOOGLE_CLIENT_ID=
MIM_AUTH_GOOGLE_CLIENT_SECRET=
MIM_AUTH_APPLE_SERVICE_ID=
MIM_AUTH_APPLE_TEAM_ID=
MIM_AUTH_APPLE_KEY_ID=
MIM_AUTH_APPLE_PRIVATE_KEY=
MIM_SMS_ALIYUN_ACCESS_KEY_ID=
MIM_SMS_ALIYUN_ACCESS_KEY_SECRET=
MIM_SMS_ALIYUN_SIGN_NAME=
# 阿里云短信模板 CODE（模板须含变量 ${code}，如 SMS_123456789）
MIM_SMS_ALIYUN_TEMPLATE_CODE=
MIM_SMS_TENCENT_SECRET_ID=
MIM_SMS_TENCENT_SECRET_KEY=
MIM_SMS_TENCENT_SDK_APP_ID=
MIM_EMAIL_ALIYUN_ACCESS_KEY=
MIM_EMAIL_SES_ACCESS_KEY_ID=
MIM_EMAIL_SES_SECRET_ACCESS_KEY=
# SES 区域（缺省回退 us-east-1）与发件人地址（须在 SES 完成验证）
MIM_EMAIL_SES_REGION=
MIM_EMAIL_SES_FROM_ADDRESS=
# 生产管理员密码登录口令（短信/邮件通道未接入时的可用登录入口，POST /api/v1/auth/password）；
# deploy/deploy.sh 幂等写入 /opt/mim/mim-api.env，已存在则保留，可用同名环境变量覆盖
MIM_AUTH_ADMIN_PASSWORD=

# ---------- 推送 ----------
MIM_PUSH_APNS_KEY_ID=
MIM_PUSH_APNS_TEAM_ID=
MIM_PUSH_APNS_PRIVATE_KEY=
MIM_PUSH_APNS_TOPIC=
MIM_PUSH_FCM_PROJECT_ID=
MIM_PUSH_FCM_SERVICE_ACCOUNT_JSON=
MIM_PUSH_HUAWEI_APP_ID=
MIM_PUSH_HUAWEI_APP_SECRET=
MIM_PUSH_XIAOMI_APP_ID=
MIM_PUSH_XIAOMI_APP_KEY=
MIM_PUSH_OPPO_APP_KEY=
MIM_PUSH_OPPO_MASTER_SECRET=
MIM_PUSH_VIVO_APP_ID=
MIM_PUSH_VIVO_APP_KEY=
MIM_PUSH_JPUSH_APP_KEY=
MIM_PUSH_JPUSH_MASTER_SECRET=
MIM_PUSH_GETUI_APP_ID=

# ---------- IM / 消息 ----------
MIM_IM_TENCENT_SDK_APP_ID=
MIM_IM_TENCENT_SECRET_KEY=
MIM_IM_HUANXIN_APP_KEY=
MIM_IM_RONGCLOUD_APP_KEY=
MIM_IM_RONGCLOUD_APP_SECRET=
MIM_IM_SENDBIRD_APP_ID=
MIM_IM_STREAM_API_KEY=
MIM_MSG_TWILIO_ACCOUNT_SID=
MIM_MSG_TWILIO_AUTH_TOKEN=

# ---------- 音视频 ----------
MIM_RTC_AGORA_APP_ID=
MIM_RTC_AGORA_APP_CERTIFICATE=
MIM_RTC_TENCENT_SDK_APP_ID=
MIM_RTC_TENCENT_SECRET_KEY=
MIM_RTC_ZEGO_APP_ID=
MIM_RTC_ZEGO_APP_SIGN=
MIM_RTC_LIVEKIT_API_KEY=
MIM_RTC_LIVEKIT_API_SECRET=
MIM_RTC_LIVEKIT_URL=

# ---------- AI ----------
MIM_AI_OPENAI_API_KEY=
MIM_AI_OPENAI_ORG_ID=
MIM_AI_ANTHROPIC_API_KEY=
MIM_AI_GEMINI_API_KEY=
MIM_AI_AZURE_OPENAI_ENDPOINT=
MIM_AI_AZURE_OPENAI_KEY=
MIM_AI_DASHSCOPE_API_KEY=
MIM_AI_ARK_API_KEY=
MIM_AI_ARK_ENDPOINT_ID=
MIM_AI_QIANFAN_API_KEY=
MIM_AI_QIANFAN_SECRET_KEY=
MIM_AI_SPARK_APP_ID=
MIM_AI_SPARK_API_KEY=
MIM_AI_SPARK_API_SECRET=
MIM_AI_KLING_ACCESS_KEY=
MIM_AI_KLING_SECRET_KEY=
MIM_AI_RUNWAY_API_KEY=
MIM_AI_TTS_ARK_APP_ID=
MIM_AI_AZURE_SPEECH_KEY=
MIM_AI_AZURE_SPEECH_REGION=
MIM_AI_ELEVENLABS_API_KEY=
MIM_AI_GATEWAY_MASTER_KEY=
# 生成任务编排使用的 AI 提供方（mock | openai；留空默认 mock）
# openai = OpenAI 兼容协议（OpenAI / 火山方舟 / DeepSeek / 百炼兼容模式），凭证复用上方 MIM_AI_OPENAI_API_KEY
MIM_AI_PROVIDER=
# OpenAI 兼容端点（留空默认 https://api.openai.com/v1；方舟填 https://ark.cn-beijing.volces.com/api/v3 等）
MIM_AI_BASE_URL=
# 文本任务模型（留空默认 gpt-4o-mini；方舟填 endpoint/推理接入点 ID）
MIM_AI_TEXT_MODEL=
# 图像任务模型（留空默认 dall-e-3，需支持 b64_json 或 url 返回）
MIM_AI_IMAGE_MODEL=
# 语音合成（TTS）模型（留空默认 tts-1；OpenAI 兼容网关如不支持会在调用时诚实失败）
MIM_AI_TTS_MODEL=
# 视频生成厂商端点（留空则视频能力不可用，/comic/auto 与导出转码不依赖此项）
MIM_AI_VIDEO_BASE_URL=
# 视频生成厂商凭证（与 MIM_AI_VIDEO_BASE_URL 同时配置才启用 video 任务类型）
MIM_AI_VIDEO_API_KEY=
# 视频生成模型（留空默认 image-to-video）
MIM_AI_VIDEO_MODEL=
# ffmpeg 可执行文件路径（留空则 compose 合成与导出转码不可用；需自行安装 ffmpeg 后填写）
MIM_FFMPEG_PATH=
# 是否随 API 进程启动后台 worker（1 启用 / 0 关闭；留空默认启用）
MIM_AI_WORKER=
# 后台 worker 轮询间隔毫秒（留空默认 2000）
MIM_AI_WORKER_INTERVAL_MS=
# 单任务成本上限（分；留空默认 100000）
MIM_AI_JOB_COST_LIMIT_MINOR=
# 单日累计成本上限（分；留空默认 500000）
MIM_AI_DAILY_COST_LIMIT_MINOR=
# 生成产物保留天数（compose 成片长期保留；留空默认 90）
MIM_AI_ASSET_TTL_DAYS=
# running 任务失联判定阈值毫秒（进程崩溃后超过该时长即回收重跑；留空默认 900000 即 15 分钟）
MIM_AI_JOB_STALE_MS=
# 同一任务最多被回收重新入队的次数（超出即判 JOB_STALE_TIMEOUT，防毒任务反复烧配额；留空默认 2）
MIM_AI_JOB_MAX_RECLAIM=
# 过期产物清理单轮条数上限（留空默认 200，避免一次删太多打满存储 IO）
MIM_ASSET_GC_BATCH=

# ---------- 内容审核 / 验证码 ----------
MIM_MODERATION_SHUME_ACCESS_KEY=
MIM_MODERATION_SHUME_APP_ID=
MIM_MODERATION_YIDUN_SECRET_ID=
MIM_MODERATION_YIDUN_SECRET_KEY=
MIM_MODERATION_ALIYUN_ACCESS_KEY=
MIM_MODERATION_TENCENT_SECRET_ID=
MIM_CAPTCHA_TENCENT_APP_ID=
MIM_CAPTCHA_GEETEST_ID=
MIM_CAPTCHA_GEETEST_KEY=

# ---------- 存储 / CDN ----------
MIM_STORAGE_ALIYUN_OSS_ACCESS_KEY_ID=
MIM_STORAGE_ALIYUN_OSS_ACCESS_KEY_SECRET=
MIM_STORAGE_ALIYUN_OSS_BUCKET=
MIM_STORAGE_TENCENT_SECRET_ID=
MIM_STORAGE_TENCENT_SECRET_KEY=
MIM_STORAGE_TENCENT_BUCKET=
MIM_STORAGE_S3_ACCESS_KEY_ID=
MIM_STORAGE_S3_SECRET_ACCESS_KEY=
MIM_STORAGE_R2_ACCESS_KEY_ID=
# 运行期存储驱动（local | s3；留空默认 local，本地磁盘无需云凭证即可真实落盘）
MIM_STORAGE_DRIVER=
# 本地驱动落盘根目录（留空默认 <服务目录>/data/media）
MIM_STORAGE_LOCAL_DIR=
# S3 兼容端点（OSS / COS / R2 / MinIO 等；AWS S3 可留空）
MIM_STORAGE_S3_ENDPOINT=
# S3 区域（如 us-east-1 / ap-beijing）
MIM_STORAGE_S3_REGION=
# S3 存储桶名（与上方 ACCESS_KEY 配套使用时必填）
MIM_STORAGE_S3_BUCKET=
# S3 路径风格（MinIO 填 1，AWS 兼容虚拟主机方式填 0）
MIM_STORAGE_S3_FORCE_PATH_STYLE=
# 对外公开基址（本地驱动预签名 URL 拼接用，如 https://mim.mixm.top）
MIM_PUBLIC_BASE_URL=
MIM_STORAGE_QINIU_ACCESS_KEY=
MIM_STORAGE_QINIU_SECRET_KEY=
MIM_CDN_CLOUDFLARE_API_TOKEN=
MIM_CDN_ALIYUN_ACCESS_KEY=

# ---------- 可观测性 / 分析 ----------
MIM_OBS_SENTRY_DSN=
MIM_OBS_SENTRY_AUTH_TOKEN=
MIM_OBS_DATADOG_API_KEY=
MIM_OBS_GRAFANA_TOKEN=
MIM_OBS_LANGFUSE_PUBLIC_KEY=
MIM_OBS_LANGFUSE_SECRET_KEY=
MIM_ANALYTICS_UMAMI_WEBSITE_ID=
MIM_ANALYTICS_GA4_MEASUREMENT_ID=
MIM_ANALYTICS_MIXPANEL_TOKEN=

# ---------- 地图与位置 ----------
MIM_MAP_AMAP_KEY=
MIM_MAP_AMAP_SECURITY_CODE=
MIM_MAP_BAIDU_AK=
MIM_MAP_TENCENT_KEY=
MIM_MAP_GOOGLE_API_KEY=
MIM_MAP_MAPBOX_TOKEN=

# ---------- 北斗卫星导航 ----------
# L2 高精度定位（纯软件，按需开通）
MIM_BDS_QIANXUN_APP_KEY=
MIM_BDS_QIANXUN_APP_SECRET=
MIM_BDS_QIANXUN_SERVICE_ID=
MIM_BDS_LIUFEN_APP_ID=
MIM_BDS_LIUFEN_APP_KEY=
MIM_BDS_CMCC_APP_ID=
MIM_BDS_CMCC_APP_SECRET=
# L3 短报文（依赖硬件终端，P0 排除项，默认不启用）
MIM_BDS_RDSS_TERMINAL_ID=
MIM_BDS_RDSS_APP_KEY=
MIM_BDS_RDSS_APP_SECRET=

# ---------- 应用自有配置 ----------
# JWT HS256 签名密钥（>=32 字符随机串，生产必配；本地开发留空则自动生成 .mim-dev-secret/jwt.key）
MIM_JWT_SECRET=
# 跨域来源白名单（逗号分隔；本模板仅留空，真实值由 CI Secret / 服务器 .env 注入）
# 仅「前端跨域直连本 API」的镜像站需要：GitHub Pages（VITE_API_ORIGIN=mixm.top）必配；
# Cloudflare Pages / Vercel 走同源 /api 反代（functions/rewrites），无需此项；留空则不启用 CORS 中间件。
# 若漏配，对应镜像站浏览器会拦截 /api/v1/modules，导致「商城看不到」。
# 参考白名单：https://afdk1991.github.io,https://mim.mixm.top,https://data.mixm.top（deploy/deploy.sh 已幂等补齐）
MIM_CORS_ORIGINS=
# 超管引导令牌（RBAC bootstrap）：缺失时 /api/v1/admin/* 等管理写路由返回 403；仅由 CI Secret 下发，禁止落盘
MIM_ADMIN_TOKEN=
# 支付渠道回调签名密钥（POST /api/v1/orders/:id/payment-notify 的 HMAC-SHA256 密钥）；
# 留空则该回调返回 503 PAYMENT_NOTIFY_NOT_CONFIGURED，人工结算（POST /orders/:id/settle）不受影响
MIM_PAYMENT_NOTIFY_SECRET=
# 后台定时任务总开关（留空默认 1 启用；显式 0 关闭，用于多副本部署只让一个实例消费）
MIM_JOBS=
