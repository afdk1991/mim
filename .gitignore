# ============================================================
# Mim .gitignore
# 目的：确保含真实密钥的本地 .env 永不进入版本库（铁律七 + 09 清单 §0 硬约束）
# ============================================================

# ---------- 密钥与环境变量 ----------
# 本地真实密钥文件，绝对禁止提交
.env
# 本地覆盖配置
.env.local
# 各环境本地覆盖（如 .env.production.local）
.env.*.local
# 显式反向豁免：占位模板必须进库（仅空值、无真实密钥）
!.env.example

# ---------- 依赖与构建产物 ----------
# 包管理器安装目录（未来引入依赖后自动生效）
node_modules/
# Monorepo 构建缓存（pnpm + Turborepo 规划形态）
.turbo/
# 通用构建输出
dist/
build/
out/

# ---------- 本地开发数据 ----------
# 本地 SQLite 数据库与 CSV 导出产物（运行时生成）
services/mim-api/data/
# 首次运行自动生成的本地开发 JWT 密钥（禁止入库）
.mim-dev-secret/
# 依赖探测目录
.probe/

# ---------- 日志与临时文件 ----------
# 运行日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# 本地临时目录
.tmp/
temp/
# Vercel 静态部署中转目录（由 CI 在 $RUNNER_TEMP 重建，不入库）
.tmp-vercel/
# DNSPod 解析导出（含账号域名清单，属私有运维数据）
dnspod_records_*.xls
# AI 工具生成的 HTML 分享包副本（含 dist/site 副本，非源码）
.trae-html-share-packages/
# EdgeOne CLI 本地项目映射（记录本机绝对路径与 projectId，属本机状态，不入库）
.edgeone/
# AI 协作者本地记忆目录（本机会话状态，不入库）
.workbuddy/

# ---------- 截图与调试产物 ----------
# 截图暂存目录中的临时文件（正式截图是否入库由后续决定）
.screenshots/.tmp/

# ---------- 编辑器与操作系统 ----------
# VS Code 本地工作区设置（个人化，不入库）
.vscode/
# JetBrains 系列 IDE 本地配置
.idea/
# macOS / Windows 系统文件
.DS_Store
Thumbs.db
