# 依赖
node_modules/
# lock 不入库：npm/cli#4828 会在解析阶段按当前平台裁剪可选依赖，跨平台复用会缺 rollup 原生二进制，CI 按平台全新安装
package-lock.json

# 构建产物
dist/
*.local

# 环境变量（真实密钥不入库；.env.example 作为模板例外放行）
.env
.env.*
!.env.example

# 日志与临时文件
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# 编辑器
.idea/
.vscode/
*.swp

# EdgeOne CLI 本地状态
.edgeone/

# IDE 会话目录与本地产物（不留备份）
.trae/
.trae-html-share-packages/
质量报告-*.html

# WorkBuddy 工作区数据：仅记忆日志入库，其余（缓存/临时产物）忽略
.workbuddy/*
!.workbuddy/memory/
.workbuddy/memory/tmp/

# 本地状态 / 令牌 / 验证产物（疑似含令牌，禁止入库）
.st.json
.st.token
.up.json
.tiny.png
verify-shots/
# 浏览器实测脚本（替代已移除的 vitest 单测）：默认本地验证用，不入库
verify-*.mjs
scripts/verify-*.mjs
# 例外放行：这两个是「离线可跑 + 确定性」的回归基线（route mock，无需外网/云端），
# 不入库会导致回归能力随工作区丢失（已发生过：verify-feed-growth.mjs 消失后无法复跑）。
# 只放行确定性脚本，依赖云端状态的一次性诊断脚本仍忽略。
!scripts/verify-openverse.mjs
!scripts/verify-routes.mjs
# 线上云端端到端回归（GitHub Pages 真实站点：注册→发布→全新会话读回），
# 是「线上实现」而非「本地实现」的唯一自动闸门，同样放行入库。
!scripts/verify-cloud-e2e.mjs
scripts/shot-*.mjs
# 浏览器自动化（playwright-core + Edge）截图产物
browser-shots/
