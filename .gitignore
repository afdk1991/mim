# ============================================================
# Mim .gitignore
# 目的：确保含真实密钥的本地 .env 永不进入版本库（铁律七 + 09 清单 §0 硬约束）
# ============================================================

# ---------- 密钥与环境变量 ----------
# 本地真实密钥文件，绝对禁止提交
.env
# 本地覆盖配置
.env.local
# 各环境本地覆盖（如 .env.production.local）
.env.*.local
# 显式反向豁免：占位模板必须进库（仅空值、无真实密钥）
!.env.example

# ---------- 依赖与构建产物 ----------
# 包管理器安装目录（未来引入依赖后自动生效）
node_modules/
# Monorepo 构建缓存（pnpm + Turborepo 规划形态）
.turbo/
# 通用构建输出
dist/
build/
out/

# ---------- 日志与临时文件 ----------
# 运行日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# 本地临时目录
.tmp/
temp/

# ---------- 截图与调试产物 ----------
# 截图暂存目录中的临时文件（正式截图是否入库由后续决定）
.screenshots/.tmp/

# ---------- 编辑器与操作系统 ----------
# VS Code 本地工作区设置（个人化，不入库）
.vscode/
# JetBrains 系列 IDE 本地配置
.idea/
# macOS / Windows 系统文件
.DS_Store
Thumbs.db
