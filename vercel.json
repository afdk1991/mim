{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.laal.top:8443/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://laal.top:8443/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
