{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @mim/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mim.mixm.top/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://mim.mixm.top/health"
    }
  ]
}
