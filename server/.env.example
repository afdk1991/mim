# 复制为 .env 后按实际环境修改。
# 本项目不使用容器：本机/服务器上由 systemd 的 EnvironmentFile 或 shell 的 export 注入，
# 服务端只读 process.env（零框架依赖，不加载 .env 文件）。
PORT=8787

# 生产建议只监听回环，由 nginx 反向代理对外（跑通前可直接留 0.0.0.0）
# HOST=127.0.0.1

# 宿主机上的 PostgreSQL（直接装的，不是容器）
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/mim

# 生产必须替换：openssl rand -hex 32
JWT_SECRET=change-me-in-production

# 全新库首个管理员（唯一一次性出口；已有管理员后该变量即失效）
BOOTSTRAP_ADMIN_USERNAME=

# 令牌有效期（毫秒，默认 7 天）
TOKEN_TTL_MS=604800000

# 秒杀锁库存时长（毫秒，默认 15 分钟，与前端 LIMITS.seckillLockMs 一致）
SECKILL_LOCK_MS=900000

# 券码最长有效期（天，默认 90，与前端 LIMITS.voucherMaxDays 一致；实际取 least(套餐valid_until, now+此值)）
VOUCHER_MAX_DAYS=90

# 对象存储：本地落盘目录 + 单文件体积上限（默认 3MB，与前端 LIMITS.uploadMaxBytes 一致）
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=3145728

# 连接池与 JSON 请求体上限（有默认值，一般不用改）
PG_POOL_MAX=10
MAX_BODY_BYTES=12582912

# 反向代理到公网时填写（决定 /api/storage/<key> 返回的 url 是否为绝对地址）
PUBLIC_API_BASE=

# 只读增量同步令牌（GET /api/sync/posts 的 x-sync-token 取值）。
# 留空 = 该端点关闭；要启用请生成后填写：openssl rand -hex 32
SYNC_TOKEN=

# ---- IoT 长连接网关（10 号文 §2，EMQX 自托管，ADR-002）----
# EMQX → 本服务钩子/上行的共享密钥（x-iot-hook-token）。
# 留空 = 钩子与上行端点全部关闭；要启用请生成后填写：openssl rand -hex 32
IOT_HOOK_TOKEN=

# EMQX 5.x 管理 API（指令下发走 /api/v5/publish；在 EMQX Dashboard「系统 → API 密钥」创建）
EMQX_API_URL=http://127.0.0.1:18083
EMQX_API_KEY=
EMQX_API_SECRET=

# ===========================================================================
# 以下为可选第三方接入占位（deploy/README.md 第二十三节）。留空即对应功能关闭。
# 真实密钥只填服务器本文件，不得进版本库。
# ===========================================================================

# ---- 内容安全 UGC 机审（发帖/评论入库前调用，二选一；当前未接）----
# TENCENT_SECRET_ID=<你的腾讯云SecretId>
# TENCENT_SECRET_KEY=<你的腾讯云SecretKey>
# ALIYUN_ACCESS_KEY_ID=<你的阿里云AKId>
# ALIYUN_ACCESS_SECRET=<你的阿里云AKSecret>

# ---- Cloudflare R2 对象存储（替换本地磁盘落点，当前未接）----
# STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=<你的Cloudflare_Account_ID>
# R2_ACCESS_KEY_ID=<你的R2_AccessKeyId>
# R2_SECRET_ACCESS_KEY=<你的R2_SecretAccessKey>
# R2_BUCKET=mim-uploads
# R2_PUBLIC_BASE=https://pub-<hash>.r2.dev

# ---- Sentry 错误监控（DSN 留空即不接入，当前未接）----
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

