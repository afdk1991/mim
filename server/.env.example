# 复制为 .env 后按实际环境修改。
# 本项目不使用容器：本机/服务器上由 systemd 的 EnvironmentFile 或 shell 的 export 注入，
# 服务端只读 process.env（零框架依赖，不加载 .env 文件）。
PORT=8787

# 生产建议只监听回环，由 nginx 反向代理对外（跑通前可直接留 0.0.0.0）
# HOST=127.0.0.1

# 宿主机上的 PostgreSQL（直接装的，不是容器）
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/mim

# 生产必须替换：openssl rand -hex 32
JWT_SECRET=change-me-in-production

# 全新库首个管理员（唯一一次性出口；已有管理员后该变量即失效）
BOOTSTRAP_ADMIN_USERNAME=

# 令牌有效期（毫秒，默认 7 天）
TOKEN_TTL_MS=604800000

# 秒杀锁库存时长（毫秒，默认 15 分钟，与前端 LIMITS.seckillLockMs 一致）
SECKILL_LOCK_MS=900000

# 对象存储：本地落盘目录 + 单文件体积上限（默认 3MB，与前端 LIMITS.uploadMaxBytes 一致）
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=3145728

# 反向代理到公网时填写（决定 /api/storage/<key> 返回的 url 是否为绝对地址）
PUBLIC_API_BASE=
