# =============================================================================
# 自托管 BaaS · 环境变量样例
#   用法：cp .env.example .env  然后至少改掉下面标了 【必改】 的项
#   注意：本机无外网时无法核对镜像 tag，若 pull 失败请把镜像换成当前存在的 tag / digest
# =============================================================================

# ---------- 对外入口 ----------
# 【必改】浏览器访问的地址（OAuth 回调、邮件链接都用它，不能用 localhost 之外的方式绕过）
SITE_URL=http://localhost:8000
# 网关监听端口
GATEWAY_PORT=8000

# ---------- 镜像版本（集中管理，pull 失败时只改这里） ----------
POSTGRES_IMAGE=supabase/postgres:17.6.1.011
AUTH_IMAGE=supabase/auth:v2.179.0
REST_IMAGE=postgrest/postgrest:v13.0.7
REALTIME_IMAGE=supabase/realtime:v2.34.47
STORAGE_IMAGE=supabase/storage-api:v1.28.0
META_IMAGE=supabase/postgres-meta:v0.91.2
EDGE_IMAGE=supabase/edge-runtime:v1.68.4
IMGPROXY_IMAGE=darthsim/imgproxy:v3.26.0
ENVOY_IMAGE=envoyproxy/envoy:v1.33-latest
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
STUDIO_IMAGE=supabase/studio:2025.08.18-sha-79ef3c8

# ---------- Postgres ----------
# 【必改】
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# 连接池（Supavisor 可选；单节点低并发可不开，见 docker-compose 的 supavisor profile）
POOLER_PORT=6543
POOL_MODE=transaction        # transaction | session
# 复制槽保留上限，防止 Realtime 掉线后 WAL 无限增长撑爆磁盘（单位 MB）
MAX_SLOT_WAL_KEEP_SIZE=1024

# ---------- 密钥 ----------
# 【必改】至少 32 字符；anon / service_role 两个 JWT 都由它签发
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# 【必改】生成方式：make keys（脚本 scripts/gen-jwt.mjs 会按上面的 JWT_SECRET 产出并自验签）
ANON_KEY=
SERVICE_ROLE_KEY=

# ---------- Auth（gotrue） ----------
# 关闭后只有邀请才能注册；生产建议 false
GOTRUE_DISABLE_SIGNUP=false
# 演示/联调可开 true（不发邮件直接确认）；生产务必 false
GOTRUE_MAILER_AUTOCONFIRM=true
# 魔法链接有效期（秒）
GOTRUE_MAILER_OTP_EXP=3600
# SMTP（留空则邮件功能不可用，只能用 autocofirm 模式）
GOTRUE_SMTP_HOST=
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_ADMIN_EMAIL=noreply@example.com
GOTRUE_SMTP_SENDER_NAME=MyBaaS

# 第三方 OAuth（留空即关闭对应渠道）
GOTRUE_EXTERNAL_GITHUB_ENABLED=false
GOTRUE_EXTERNAL_GITHUB_CLIENT_ID=
GOTRUE_EXTERNAL_GITHUB_SECRET=
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
# 回调地址固定为 ${SITE_URL}/auth/v1/callback，需在 OAuth 应用后台登记同一个值

# ---------- Storage ----------
# file = 本地文件后端（零依赖，单节点推荐）；s3 = 走 S3/MinIO（需 --profile s3）
STORAGE_BACKEND=file
FILE_SIZE_LIMIT=52428800
# 只在 STORAGE_BACKEND=s3 时生效
GLOBAL_S3_BUCKET=baas-storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
# 图片处理（imgproxy）与 CDN
ENABLE_IMAGE_TRANSFORMATION=true
CDN_URL=

# ---------- Edge Functions 运行时注入 ----------
# 函数内部直接读 Deno.env.get('SUPABASE_URL') 等，见 baas/functions/
FUNCTIONS_INTERNAL_URL=http://rest:3000
# 向量化服务（OpenAI 兼容的 /v1/embeddings 即可）
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# 向量维度需与 db/migrations/0006_vector.sql 里的 vector(N) 保持一致
EMBEDDING_DIM=1536
