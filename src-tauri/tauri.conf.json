{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mim",
  "version": "0.1.0",
  "identifier": "com.afdk1991.mim",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mim",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self' data: https: blob:; connect-src 'self' https://api.github.com https://*.edgeone.cool https://*.workers.dev https://api.coingecko.com https://api.coinbase.com https://api.open-meteo.com https://api.wheretheiss.at https://api.sunrise-sunset.org https://open.er-api.com; font-src 'self' data:; frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGQTdFOUUyM0MxMEYyREMKUldUYzhoQTg0dW1uZjhiWnEwcjE4ajRqdkkyS2NPZ0sxQ0Zod2FIWHF3U2xRMVhwaFBFWlFnL2UK",
      "endpoints": [
        "https://github.com/afdk1991/mim/releases/latest/download/latest.json"
      ]
    }
  }
}
