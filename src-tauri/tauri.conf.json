{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mim",
  "version": "0.0.0",
  "identifier": "com.afdk1991.mim",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mim",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyMkZCNjI1N0U1N0JCNEQKUldSTnUxZCtKYll2SW5UZ2dFbW15U3BydXlZNUtNRkJSS1N2S0d4OU9yY0lYd2ZyT2M3VjF0R04K",
      "endpoints": [
        "https://github.com/afdk1991/mim/releases/latest/download/latest.json"
      ]
    }
  }
}
