{
  "name": "mim",
  "version": "0.0.2",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "description": "Mim 产品底座（Headless 中台 + 多端薄壳）。apps/ 多端薄壳，packages/ 共享包，services/ 后端服务，scripts/ 校验脚本。",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:web": "pnpm --filter @mim/web build",
    "build:admin": "pnpm --filter @mim/admin build",
    "dev": "pnpm --filter @mim/api dev",
    "dev:api": "pnpm --filter @mim/api dev",
    "dev:web": "pnpm --filter @mim/web dev",
    "dev:admin": "pnpm --filter @mim/admin dev",
    "test": "pnpm --filter @mim/api test",
    "typecheck": "pnpm -r typecheck",
    "check:version": "node scripts/version-check.mjs",
    "check:env": "node scripts/env-check.mjs",
    "check:comments": "node scripts/comment-check.mjs",
    "verify:auth-gate": "node scripts/verify-auth-gate.mjs",
    "serve:local": "node scripts/serve-local.mjs",
    "verify:film-export": "node scripts/verify-film-export.mjs",
    "verify:chat-flow": "node scripts/verify-chat-flow.mjs",
    "verify:chat-plus": "node scripts/verify-chat-plus.mjs",
    "verify:site-directory": "node scripts/verify-site-directory.mjs",
    "verify:site-modules": "node scripts/verify-site-modules.mjs",
    "verify:entry-manifest": "node scripts/verify-entry-manifest.mjs",
    "summary:deployments": "node scripts/deployment-summary.mjs",
    "verify:deployments": "node scripts/verify-deployments.mjs",
    "verify:custom-domains": "node scripts/verify-custom-domains.mjs",
    "check": "node scripts/version-check.mjs && node scripts/env-check.mjs && node scripts/comment-check.mjs && node scripts/verify-custom-domains.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
