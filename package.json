{
  "name": "mim",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "description": "Mim 全平台产品底座（Headless 中台 + 多端薄壳）。apps/ 多端薄壳，packages/ 共享包，services/ 后端服务，site/ 静态站点，scripts/ 校验脚本。",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:web": "pnpm --filter @mim/web build",
    "build:admin": "pnpm --filter @mim/admin build",
    "build:site": "node scripts/build.mjs --site",
    "deploy": "bash deploy/deploy.sh",
    "deploy:bootstrap": "bash deploy/bootstrap.sh",
    "dev": "pnpm --filter @mim/api dev",
    "dev:api": "pnpm --filter @mim/api dev",
    "dev:web": "pnpm --filter @mim/web dev",
    "dev:admin": "pnpm --filter @mim/admin dev",
    "test": "pnpm --filter @mim/api test",
    "typecheck": "pnpm -r typecheck",
    "check:version": "node scripts/version-check.mjs",
    "check:env": "node scripts/env-check.mjs",
    "check:comments": "node scripts/comment-check.mjs",
    "verify:auth-gate": "node scripts/verify-auth-gate.mjs",
    "serve:local": "node scripts/serve-local.mjs",
    "verify:film-export": "node scripts/verify-film-export.mjs",
    "check": "node scripts/version-check.mjs && node scripts/env-check.mjs && node scripts/comment-check.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
