{
  "name": "mim",
  "private": true,
  "version": "0.1.0",
  "description": "Mim 内容聚合社区 Web 应用（动态 / 文章 / 商城 / 工具台）",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",

    "server:install": "npm --prefix server install",
    "server:dev": "npm --prefix server run dev",
    "server:up": "docker compose -f server/docker-compose.yml up -d",
    "server:down": "docker compose -f server/docker-compose.yml down",
    "server:migrate": "npm --prefix server run migrate",
    "server:health": "node scripts/server-health.mjs",

    "verify:routes": "node scripts/verify-routes.mjs",
    "verify:backend": "node scripts/verify-backend.mjs",
    "version:check": "node scripts/version-check.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "pg": "^8.23.1",
    "playwright-core": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
