{
  "name": "mim",
  "version": "0.0.0",
  "private": true,
  "description": "Mim 全平台产品底座（Headless 中台 + 多端薄壳）。当前为规划与站点阶段：docs/ 为产品与技术决策，site/ 为可部署静态站点（落地页 + PRD），scripts/ 为版本与密钥校验。",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:version": "node scripts/version-check.mjs",
    "check:env": "node scripts/env-check.mjs",
    "check": "node scripts/version-check.mjs && node scripts/env-check.mjs"
  },
  "engines": {
    "node": ">=16.7.0"
  }
}
