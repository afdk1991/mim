{
  "version": "0.9.2",
  "rateLimit": {
    "windowMs": 10000,
    "max": 20
  },
  "whitelist": [],
  "blacklist": [],
  "signatures": [
    {
      "id": "sqli-1",
      "type": "sqli",
      "reason": "SQL injection attempt",
      "pattern": "(union\\s+select|select\\s+.+\\s+from|insert\\s+into|delete\\s+from|drop\\s+table|'\\s+or\\s+'|--\\s|sleep\\s*\\()",
      "flags": "i"
    },
    {
      "id": "xss-1",
      "type": "xss",
      "reason": "XSS attempt",
      "pattern": "(<script|javascript:|onerror\\s*=|onload\\s*=|alert\\s*\\(|document\\.cookie)",
      "flags": "i"
    },
    {
      "id": "traversal-1",
      "type": "traversal",
      "reason": "Path traversal attempt",
      "pattern": "(\\.\\./|\\.\\.\\\\|%2e%2e/|/etc/passwd|/proc/self|\\.\\.\\/)",
      "flags": "i"
    },
    {
      "id": "sensitive-1",
      "type": "sensitive",
      "reason": "Sensitive file probe",
      "pattern": "(\\.env(\\?|$)|\\.git/|wp-config\\.php|\\.htaccess|\\.sql(\\?|$)|config\\.php|\\.bak(\\?|$))",
      "flags": "i"
    }
  ]
}
