{
  // worker/wrangler.jsonc —— Mim 可选边缘层（Cloudflare Workers）配置
  //
  // 【定位】Mim 主路线 = 自托管 systemd + nginx，本配置仅在启用边缘层时使用。
  // 使用前先创建资源，然后把 <创建后回填> 占位替换为真实值：
  //   wrangler d1 create mim-readonly          # 输出 database_id
  //   wrangler kv namespace create MIM_CACHE   # 输出 id
  //   wrangler d1 migrations apply mim-readonly --remote
  // 密钥（SYNC_TOKEN / HEALTH_CHECK_SECRET）不要写在这里，用：
  //   wrangler secret put SYNC_TOKEN
  //   wrangler secret put HEALTH_CHECK_SECRET

  "name": "mim-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // 上游地址（替换为实际值；带 Makers 的变量留空字符串即不启用该容灾路径）
  "vars": {
    // 主站上游地址。当前指向本机后端的临时公网隧道（cloudflared quick tunnel，会话级有效）。
    // 生产环境应替换为真实主站域名（如 https://mim.example.com）并重新 wrangler deploy。
    // 留空字符串 = 禁用主站上游（probe 返回 false，请求走降级路径）。
    "OCI_TUNNEL": "https://path-algorithm-measured-networking.trycloudflare.com",
    "MAKERS_ORIGIN": "",
    "CN_MAKERS_ORIGIN": "",
    "CN_ORIGIN": "",
    "APP_ENV": "production",
    "APP_VERSION": "0.0.0.0",
    "MAINTENANCE_MODE": false
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mim-readonly",
      "database_id": "ebb554f5-04d3-412c-9d9b-684c1a9e4210"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "523add2ffff64547878c146a8cf684c2"
    }
  ],

  // 每天 03:00 UTC 拉取主站只读增量写 D1
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
